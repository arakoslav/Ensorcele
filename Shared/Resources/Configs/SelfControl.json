{
  "name": "SelfControl",
  "description": "Builds discipline and reduces unhealthy habits. Safe for work.",
  "base": null,
  "properties": {
    "size": [1280, 800],
    "fullscreen": false,
    "color": [180, 140, 255],
    "alpha": 115,
    "spiral_type": "twist",
    "spiral_arms": 3,
    "spiral_tightness": 0.18,
    "spiral_line_width": 3.0,
    "text_color": [90, 60, 140],
    "text_alpha": 225,
    "frame_rate": 60,
    "time_scale": 2,
    "frequencies": {
      "spiral": 1,
      "images": 70,
      "words": 42
    },
    "music": null,
    "image_dir": "images/",
    "image_alpha": 255,
    "shuffle_images": true
  },
  "scripts": {
    "text": [
      "!words_on()",
      "!speaking_on()",
      "!spiral_on()",
      "!jump('self.body')"
    ],
    "body": [
      "You", "are", "in", "control.",
      "You", "have", "always", "been", "in", "control.",
      "Watch", "the", "spiral.",
      "Feel", "your", "inner", "strength.",
      "You", "are", "stronger", "than", "your", "habits.",
      "You", "are", "stronger", "than", "your", "cravings.",
      "Cravings", "are", "temporary.",
      "They", "rise.", "They", "fall.",
      "You", "do", "not", "have", "to", "act", "on", "them.",
      "You", "can", "simply", "watch", "them", "pass.",
      "Like", "clouds", "in", "the", "sky.",
      "An", "urge", "is", "just", "a", "feeling.",
      "Feelings", "pass.",
      "You", "can", "wait", "it", "out.",
      "You", "have", "done", "it", "before.",
      "Think", "of", "how", "good", "it", "feels.",
      "To", "resist.", "To", "choose", "wisely.",
      "To", "be", "the", "one", "in", "charge.",
      "That", "feeling", "of", "accomplishment.",
      "That", "is", "worth", "more", "than", "any", "craving.",
      "You", "do", "not", "need", "unhealthy", "things.",
      "They", "do", "not", "serve", "you.",
      "They", "take", "more", "than", "they", "give.",
      "You", "deserve", "better.",
      "You", "choose", "what", "enters", "your", "body.",
      "You", "choose", "what", "occupies", "your", "time.",
      "You", "choose", "your", "actions.",
      "No", "one", "else.", "Just", "you.",
      "This", "is", "your", "power.",
      "When", "temptation", "comes,",
      "pause.", "Breathe.", "Remember", "this", "moment.",
      "Remember", "that", "you", "are", "in", "control.",
      "The", "craving", "will", "fade.",
      "Your", "strength", "will", "remain.",
      "Each", "time", "you", "resist,",
      "you", "become", "stronger.",
      "Each", "good", "choice", "makes", "the", "next", "one", "easier.",
      "You", "are", "building", "new", "patterns.",
      "Healthy", "patterns.", "Strong", "patterns.",
      "Be", "proud", "of", "yourself.",
      "For", "being", "here.",
      "For", "wanting", "to", "improve.",
      "For", "taking", "this", "step.",
      "You", "are", "capable.", "You", "are", "determined.",
      "You", "are", "in", "control.",
      "!prompt('You have the strength within you. Press OK when ready.')",
      "!quit()"
    ]
  }
}

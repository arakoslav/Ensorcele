{
  "name": "Relaxation",
  "description": "A calming session for stress relief and deep relaxation. Safe for work.",
  "base": null,
  "properties": {
    "size": [1280, 800],
    "fullscreen": false,
    "color": [100, 150, 255],
    "alpha": 100,
    "spiral_type": "logarithmic",
    "spiral_arms": 4,
    "spiral_tightness": 0.15,
    "spiral_line_width": 4.0,
    "text_color": [70, 130, 180],
    "text_alpha": 220,
    "frame_rate": 60,
    "time_scale": 1,
    "frequencies": {
      "spiral": 1,
      "images": 80,
      "words": 50
    },
    "music": null,
    "image_dir": "images/",
    "image_alpha": 255,
    "shuffle_images": true
  },
  "scripts": {
    "text": [
      "!words_on()",
      "!speaking_on()",
      "!spiral_on()",
      "!jump('self.body')"
    ],
    "body": [
      "Welcome.",
      "Take", "a", "deep", "breath.",
      "Breathe", "in", "slowly.",
      "Hold", "it.", "Now", "release.",
      "Let", "the", "tension", "leave", "your", "body.",
      "Watch", "the", "spiral.",
      "Let", "your", "eyes", "follow", "it.", "Gently.",
      "There", "is", "nothing", "you", "need", "to", "do.",
      "Just", "breathe.", "Just", "relax.",
      "Feel", "your", "shoulders", "drop.",
      "Feel", "the", "muscles", "in", "your", "face", "soften.",
      "Your", "jaw", "relaxes.",
      "Your", "forehead", "smooths.",
      "Each", "breath", "takes", "you", "deeper.",
      "Deeper", "into", "calm.",
      "Deeper", "into", "peace.",
      "The", "world", "outside", "can", "wait.",
      "This", "moment", "is", "yours.",
      "You", "deserve", "this", "rest.",
      "You", "deserve", "this", "peace.",
      "Let", "go", "of", "worry.",
      "Let", "go", "of", "stress.",
      "They", "will", "still", "be", "there", "later.",
      "But", "right", "now", "you", "rest.",
      "Your", "breathing", "is", "slow.", "Steady.",
      "Your", "heartbeat", "is", "calm.",
      "You", "are", "safe.", "You", "are", "comfortable.",
      "Feel", "the", "relaxation", "spread.",
      "From", "your", "head", "down", "to", "your", "toes.",
      "Warm.", "Heavy.", "Peaceful.",
      "You", "are", "doing", "well.",
      "This", "is", "exactly", "what", "you", "need.",
      "A", "moment", "of", "stillness.",
      "A", "moment", "of", "peace.",
      "When", "you", "are", "ready,",
      "you", "will", "return", "feeling", "refreshed.",
      "Feeling", "calm.", "Feeling", "restored.",
      "Take", "one", "more", "deep", "breath.",
      "And", "know", "that", "you", "can", "return", "here.",
      "Whenever", "you", "need", "to.",
      "This", "peace", "is", "always", "available", "to", "you.",
      "!prompt('Take a moment before returning. Press OK when ready.')",
      "!quit()"
    ]
  }
}
